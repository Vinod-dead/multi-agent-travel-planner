# Copy this file to ".env" and edit. Every setting is optional.
# The app works with NO model at all (offline estimates), so you can start without changing anything.

# ---------------------------------------------------------------- language model
# Any OpenAI-compatible server. Default: Ollama running on this computer.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=your_nvidia_api_key_here
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Other examples (uncomment ONE block):
# NVIDIA NIM:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1   LLM_MODEL=meta/llama-3.3-70b-instruct   LLM_API_KEY=nvapi-...
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini   LLM_API_KEY=sk-...
# LM Studio:   LLM_BASE_URL=http://localhost:1234/v1    LLM_MODEL=your-loaded-model   LLM_API_KEY=lm-studio
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile   LLM_API_KEY=gsk_...

# Set to false to never call a model (always use offline estimates).
LLM_ENABLED=true
# Seconds to wait for one model answer. Raise this for big models on slow computers.
LLM_TIMEOUT=180
# Extra attempts when the model returns broken JSON.
LLM_RETRIES=2
# How many model calls may run at once. Ollama on a laptop works best with 1-2.
LLM_CONCURRENCY=2
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
# Ask the server for strict JSON. The app turns this off by itself if the server rejects it.
LLM_JSON_MODE=true

# Extra JSON sent with every request. Needed by "thinking" models (NVIDIA Nemotron 3 etc.) that
# otherwise spend all tokens reasoning and return an empty answer. Leave empty for other models.
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# ---------------------------------------------------------------- optional web research
# https://tavily.com - adds real web sources to the destination overview.
TAVILY_API_KEY=

# ---------------------------------------------------------------- app
DEFAULT_CURRENCY=INR
MAX_DAYS=21
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Where plan history (SQLite) is stored.
DATA_DIR=data
